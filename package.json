{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "pnpm audit",
    "commitlint": "commitlint",
    "build": "vp build && vp build --ssr",
    "build:ssr": "vp build --ssr",
    "preview": "vp preview",
    "dev": "vp dev",
    "check": "vp check && eslint 'resources/js/**/*.vue'",
    "check:fix": "vp check --fix",
    "lint:templates": "eslint 'resources/js/**/*.vue'",
    "types:check": "vue-tsc --noEmit",
    "test": "vp test",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@inertiajs/vite": "^3.9.1",
    "@inertiajs/vue3": "^3.9.1",
    "@laravel/passkeys": "^0.2.0",
    "@lucide/vue": "^1.60.0",
    "@tanstack/vue-query": "^5.104.5",
    "@tanstack/vue-query-devtools": "^6.3.5",
    "@vueuse/core": "^15.0.0",
    "@zootools/email-spell-checker": "^1.12.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "ky": "^2.2.0",
    "laravel-vite-plugin": "^3.2.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.44",
    "vue-input-otp": "^0.3.2",
    "vue-sonner": "^2.0.9",
    "vue-turnstile": "^1.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@laravel/vite-plugin-wayfinder": "^0.1.11",
    "@oxlint/plugins": "^1.89.0",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.2.0",
    "happy-dom": "^21.0.3",
    "lefthook": "^2.2.2",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-blade": "^3.3.3",
