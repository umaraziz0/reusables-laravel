  "optionalDependencies": {
    "@laravel/multiplex": "^0.4.5",
    "@rollup/rollup-linux-x64-gnu": "^4.64.12",
    "@rollup/rollup-win32-x64-msvc": "^4.64.12",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.3.3",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.3.3",
