APP_NAME=reusables-laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://reusables-laravel.test

VITE_APP_NAME="${APP_NAME}"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Laravel Boost --- #

BOOST_RULES_SCOPED_GUIDELINES=true

# --- CORS --- #

CORS_ALLOWED_ORIGINS=
CORS_MAX_AGE=86400
CORS_SUPPORTS_CREDENTIALS=false

# API IP Whitelist (comma-separated IPs and CIDR ranges)
# Example: 203.0.113.10,10.0.0.0/8
API_ALLOWED_IPS=

# --- Logging --- #

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database --- #

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reusables_laravel
DB_USERNAME=postgres
DB_PASSWORD=

# TELESCOPE_DB_CONNECTION=telescope_pgsql
# TELESCOPE_DB_DATABASE=reusables_laravel_telescope
# TELESCOPE_DB_USERNAME=postgres

# PULSE_DB_CONNECTION=pulse_pgsql
# PULSE_DB_DATABASE=reusables_laravel_pulse
# PULSE_DB_USERNAME=postgres

# HEALTH_DB_CONNECTION=health_pgsql
# HEALTH_DB_DATABASE=reusables_laravel_health
# HEALTH_DB_USERNAME=postgres

# --- Broadcasting --- #

BROADCAST_CONNECTION=log

# --- Redis --- #

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis

MEMCACHED_HOST=127.0.0.1

# --- Queues --- #

QUEUE_CONNECTION=redis
# Comma-separated emails to notify on job failure (empty = disabled)
QUEUE_FAILED_NOTIFICATION_EMAILS=

# --- Session --- #

SESSION_DRIVER=redis
SESSION_CONNECTION=session
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Mail --- #

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Filesystem --- #

FILESYSTEM_DISK=local

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

DO_ACCESS_KEY_ID=
DO_SECRET_ACCESS_KEY=
DO_DEFAULT_REGION=sgp1
DO_BUCKET=
DO_ROOT=dev
DO_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_CDN_ENDPOINT=
DO_USE_PATH_STYLE_ENDPOINT=false
DO_PURGE_CDN_API_TOKEN=

#  --- Turnstile --- #

VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Octane --- #

OCTANE_SERVER=frankenphp

# --- Nightwatch --- #

NIGHTWATCH_TOKEN=

# Nightwatch Sampling
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.01 # 1% of requests - saves quota
NIGHTWATCH_EXCEPTION_SAMPLE_RATE=1.0 # 100% of errors
NIGHTWATCH_COMMAND_SAMPLE_RATE=0 # 0% of commands
NIGHTWATCH_SCHEDULED_TASK_SAMPLE_RATE=1.0 # Sample 100% of tasks

NIGHTWATCH_LOG_LEVEL=warning # only log warnings and errors

# Nightwatch Filtering
NIGHTWATCH_IGNORE_CACHE_EVENTS=true
NIGHTWATCH_IGNORE_NOTIFICATIONS=true
NIGHTWATCH_IGNORE_MAIL=true # Keep mail on if you need to track delivery
NIGHTWATCH_IGNORE_QUERIES=false # turn this on if need quota optimization - still get per request duration
